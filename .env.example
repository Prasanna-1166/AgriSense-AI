# AgriSense AI — Environment Variables (all optional)
# Copy this file to .env if you use a tool like python-dotenv, or set
# these directly in your shell / PowerShell session before running the app.
#
# No API keys are required — geocoding, weather, and soil services all
# use free, keyless public APIs.

# Host to bind the Flask server to
AGRISENSE_HOST=127.0.0.1

# Port to bind the Flask server to
AGRISENSE_PORT=5000

# Set to 1 to enable Flask debug mode (auto-reload, detailed error pages).
# Do NOT enable this in production.
AGRISENSE_DEBUG=0

# Set to 1 to force model retraining on startup (NOT recommended for normal
# use — training is meant to be a separate, explicit step; see README).
AGRISENSE_FORCE_RETRAIN=0
